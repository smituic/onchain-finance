# Environment variables for onchain-finance.
#
# Copy to .env.local for local overrides. Never commit a real .env file
# (see .gitignore). Add each new variable here with a placeholder value and a
# comment explaining its purpose and whether it is public (NEXT_PUBLIC_*,
# inlined into the browser bundle at build time) or server-only.

# --- Real Mode (Phase 2) ------------------------------------------------------

# Whether Real Mode exists in this build. Off by default: an unconfigured
# build is the Practice-only app. Public and build-time — changing it needs a
# rebuild. Authoritative over any mode a browser remembers: a build with this
# off falls back to Practice even if localStorage says "real".
NEXT_PUBLIC_REAL_MODE_ENABLED=false

# --- Isolated Turnkey PoC (poc/turnkey-real-account only) ---------------------
# Developer route /dev/turnkey-poc. Off by default. Not product Real Mode.
# Public / build-time.
NEXT_PUBLIC_TURNKEY_POC_ENABLED=false
# WebAuthn RP ID. Use "localhost" for local http://localhost:3000.
NEXT_PUBLIC_TURNKEY_RP_ID=localhost
NEXT_PUBLIC_TURNKEY_RP_NAME=ON Chain Finance Turnkey PoC
# Optional public Base Sepolia RPC for browser reads. No secret.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Server-only Turnkey parent provisioning/read credential. NEVER expose to the
# browser. Must not be registered as a child root/signing credential.
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_PARENT_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# HMAC secret for the HttpOnly app-identity cookie. Not a wallet credential.
TURNKEY_POC_SESSION_SECRET=

# Server-only Pimlico bundler/paymaster key. Browser talks only to
# /api/dev/turnkey-poc/pimlico. Restrict the Pimlico dashboard policy to
# Base Sepolia, EntryPoint 0.7, and small test quotas.
PIMLICO_API_KEY=
# Optional server RPC override for balance/history reads.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
