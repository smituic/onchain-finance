# Environment variables for onchain-finance.
#
# Copy to .env.local for local overrides. Never commit a real .env file
# (see .gitignore). Add each new variable here with a placeholder value and a
# comment explaining its purpose and whether it is public (NEXT_PUBLIC_*,
# inlined into the browser bundle at build time) or server-only.

# --- Real Mode (Phase 2) ------------------------------------------------------

# Whether Real Mode exists in this build. Off by default: an unconfigured
# build is the Practice-only app. Public and build-time — changing it needs a
# rebuild. Authoritative over any mode a browser remembers: a build with this
# off falls back to Practice even if localStorage says "real".
NEXT_PUBLIC_REAL_MODE_ENABLED=false

# WebAuthn relying-party config for app login (independent of Turnkey — see
# ARCHITECTURE.md). rpID must be a valid domain (no scheme/port); "localhost"
# for local dev. Origin(s) are exact scheme+host+port, comma-separated if more
# than one (e.g. a preview deployment domain in addition to production).
# SECURITY (S5, M3): set rpID to the EXACT app host, never a parent domain.
# Passkey signing goes browser -> Turnkey directly, so any page on an origin
# under the rpID can prompt this account's passkeys, and the server's origin
# checks never see it.
NEXT_PUBLIC_REAL_RP_ID=localhost
NEXT_PUBLIC_REAL_RP_NAME=onchain-finance
NEXT_PUBLIC_REAL_ORIGIN=http://localhost:3000

# Server-only HMAC secret for the HttpOnly app-session cookie. Not a wallet
# credential — the session it signs never authorizes Turnkey signing.
# Must be hex or base64/base64url encoding >= 32 random bytes — passphrases
# are refused. E.g. `openssl rand -hex 32`. Changing it signs everyone out.
REAL_SESSION_SECRET=

# Server-only Turnkey parent provisioning/read credential. NEVER expose to
# the browser. Must not be registered as a child root/signing credential.
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_PARENT_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# Base Sepolia RPC used server-side to derive/verify the Safe address at
# registration time, to read the real Cash balance, and to re-check that
# balance live when preparing a payment. Falls back to the public Base
# Sepolia RPC if unset.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Server-only Neon Postgres connection string for the durable account/
# passkey/challenge/registration-attempt/payment-attempt tables
# (lib/real/server/schema.sql). NEVER expose to the browser. When unset,
# Real Mode falls back to an in-memory store that resets on every server
# restart — fine for local development, not for anything that must survive
# a restart or run more than one server instance (including the payment
# quota/reservation guarantees in Batch 2d, which depend on Postgres). In a
# production build (NODE_ENV=production), Real Mode server routes fail
# closed with a clear error instead of silently falling back when this is
# unset.
DATABASE_URL=

# Server-only Pimlico API key (bundler + paymaster for sponsored Real Pay
# UserOperations, Batch 2d). NEVER expose to the browser — reached only from
# lib/real/server/pimlico.ts and app/api/real/payments/** route handlers.
PIMLICO_API_KEY=
