# Environment variables for onchain-finance.
#
# Copy to .env.local for local overrides. Never commit a real .env file
# (see .gitignore). Add each new variable here with a placeholder value and a
# comment explaining its purpose and whether it is public (NEXT_PUBLIC_*,
# inlined into the browser bundle at build time) or server-only.

# --- Real Mode (Phase 2) ------------------------------------------------------

# Whether Real Mode exists in this build. Off by default: an unconfigured
# build is the Practice-only app. Public and build-time — changing it needs a
# rebuild. Authoritative over any mode a browser remembers: a build with this
# off falls back to Practice even if localStorage says "real".
NEXT_PUBLIC_REAL_MODE_ENABLED=false

# --- Privy proof-of-concept (poc/privy-real-account branch; DISPOSABLE) ------
#
# Gates the developer-only diagnostic at /dev/privy-poc. Off by default: the
# route is a 404 and no Privy code runs. Public and build-time.
NEXT_PUBLIC_PRIVY_POC_ENABLED=false

# Privy app ID from the Privy Dashboard (a public identifier, safe in the
# browser bundle). Use a DEVELOPMENT app — never a production app ID here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional Privy "app client" ID (Dashboard → Configuration → Clients). Public.
# Only needed if the app uses per-client allowed origins / cookie domains.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Optional Base Sepolia RPC for chain READS only (balances, code, receipts).
# Defaults to the public https://sepolia.base.org. Public. Sends never use
# this URL — they go through Privy's sponsored wallet RPC.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
#
# There are deliberately NO secret variables for this PoC: the selected
# sponsorship path (Privy native gas sponsorship) is configured entirely in
# the Privy Dashboard and needs no paymaster/bundler key in this repo.
