# Environment variables for onchain-finance.
#
# Copy to .env.local for local overrides. Never commit a real .env file
# (see .gitignore). Add each new variable here with a placeholder value and a
# comment explaining its purpose and whether it is public (NEXT_PUBLIC_*,
# inlined into the browser bundle at build time) or server-only.

# --- Real Mode (Phase 2) ------------------------------------------------------

# Whether Real Mode exists in this build. Off by default: an unconfigured
# build is the Practice-only app. Public and build-time — changing it needs a
# rebuild. Authoritative over any mode a browser remembers: a build with this
# off falls back to Practice even if localStorage says "real".
NEXT_PUBLIC_REAL_MODE_ENABLED=false

# --- CDP proof-of-concept (disposable; branch poc/cdp-real-account) -----------

# Makes /dev/cdp-poc exist. Off by default (the route is a 404). Public,
# build-time. The page is a developer diagnostic and is never linked from the
# product.
NEXT_PUBLIC_CDP_POC_ENABLED=false

# CDP Project ID from https://portal.cdp.coinbase.com (a UUID). This is a
# public identifier that ships in the browser bundle — it is NOT an API key
# or secret. Never put a CDP API key or wallet secret in any NEXT_PUBLIC_* var.
NEXT_PUBLIC_CDP_PROJECT_ID=

# Optional https:// Base Sepolia JSON-RPC URL for balance/receipt reads. Leave
# empty to use viem's public default for Base Sepolia. Public.
NEXT_PUBLIC_CDP_POC_RPC_URL=
